# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Na Vercel, cadastre as mesmas variáveis em
# Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional — CAPTCHA no login (Cloudflare Turnstile, gratuito). Veja DEPLOY.md.
# Deixe vazio para desligar.
VITE_TURNSTILE_SITE_KEY=
